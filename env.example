# LaunchDarkly Configuration Template
# Copy this file to .env.local and fill in your actual keys
# Never commit .env.local to version control!
#
# Get your keys from LaunchDarkly Dashboard:
# Account Settings > Projects > [Your Project] > Environments > [Environment]

# Backend - Server SDK Key (starts with "sdk-")
LD_SDK_KEY=your-server-sdk-key-here

# Backend - Project Key (optional)
LD_PROJECT_KEY=your-project-key-here

# Frontend - Client-side ID (alphanumeric string)
LD_CLIENT_ID=your-client-side-id-here

